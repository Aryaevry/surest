						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Only fetch a new token if accessToken is empty or expired\r",
									"const username = \"admin123\";\r",
									"const password = \"admin123\";\r",
									"const baseUrl = \"localhost:8080\";\r",
									"\r",
									"// Optionally, you can add token expiry check here if your API provides expiry time\r",
									"\r",
									"pm.sendRequest({\r",
									"    url: `${baseUrl}/auth/login`,\r",
									"    method: 'POST',\r",
									"    header: {\r",
									"        'Content-Type': 'application/json'\r",
									"    },\r",
									"    body: {\r",
									"        mode: 'raw',\r",
									"        raw: JSON.stringify({\r",
									"            username: username,\r",
									"            password: password\r",
									"        })\r",
									"    }\r",
									"}, function (err, res) {\r",
									"    if (err) {\r",
									"        console.log(\"Error fetching token:\", err);\r",
									"    } else {\r",
									"        const jsonResponse = res.json();\r",
									"        // Save the token in environment variable named 'token'\r",
									"        pm.environment.set(\"token\", jsonResponse.token);\r",
									"        console.log(\"Token fetched and saved as {{token}}:\", jsonResponse.access_token);\r",
									"    }\r",
									"});"
								],
								"type": "text/javascript",
